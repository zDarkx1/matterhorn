## 9. Backend Modules — Detail Implementation

### 9.1 StockService (Critical Module)

```php
class StockService
{
    /**
     * Cek ketersediaan stok untuk date range tertentu.
     * Hitung berapa unit yang sedang disewa dalam overlap period.
     */
    public function getAvailableStock(int $productId, string $startDate, string $endDate): int
    {
        $product = Product::findOrFail($productId);

        // Hitung total unit yang sedang disewa (status: confirmed, picked_up, active)
        // dengan tanggal yang overlap dengan request
        $rentedQty = RentalItem::whereHas('rental', function ($q) use ($startDate, $endDate) {
            $q->whereIn('status', ['confirmed', 'picked_up', 'active', 'pending_payment', 'payment_uploaded'])
              ->where('rental_start', '<=', $endDate)
              ->where('rental_end', '>=', $startDate);
        })
        ->where('product_id', $productId)
        ->sum('quantity');

        return max(0, $product->stock - $rentedQty);
    }

    /**
     * Cek apakah quantity yang diminta tersedia
     */
    public function isAvailable(int $productId, int $qty, string $start, string $end): bool
    {
        return $this->getAvailableStock($productId, $start, $end) >= $qty;
    }
}
```

### 9.2 PricingService

```php
class PricingService
{
    public function calculateItemSubtotal(int $pricePerDay, int $quantity, int $totalDays): int
    {
        return $pricePerDay * $quantity * $totalDays;
    }

    public function calculateDays(string $startDate, string $endDate): int
    {
        return Carbon::parse($startDate)->diffInDays(Carbon::parse($endDate)) + 1;
        // +1 karena hari mulai = hari pertama sewa
    }

    public function calculateCartTotal(Cart $cart): array
    {
        $subtotal = 0;
        $depositTotal = 0;

        foreach ($cart->items as $item) {
            $days = $this->calculateDays($item->rental_start, $item->rental_end);
            $subtotal += $this->calculateItemSubtotal(
                $item->product->price_per_day,
                $item->quantity,
                $days
            );
            $depositTotal += $item->product->deposit_amount * $item->quantity;
        }

        return [
            'subtotal' => $subtotal,
            'deposit_total' => $depositTotal,
            'grand_total' => $subtotal + $depositTotal,
        ];
    }
}
```

### 9.3 RentalService (Checkout Flow)

```php
class RentalService
{
    public function __construct(
        private StockService $stockService,
        private PricingService $pricingService,
    ) {}

    public function checkout(User $user, string $paymentMethod, ?string $notes): Rental
    {
        $cart = $user->cart()->with('items.product')->firstOrFail();

        if ($cart->items->isEmpty()) {
            throw new \Exception('Keranjang kosong');
        }

        // 1. Validate stock for ALL items
        foreach ($cart->items as $item) {
            if (!$this->stockService->isAvailable(
                $item->product_id, $item->quantity,
                $item->rental_start, $item->rental_end
            )) {
                throw new \Exception("Stok {$item->product->name} tidak mencukupi untuk tanggal tersebut");
            }
        }

        // 2. Calculate pricing
        $pricing = $this->pricingService->calculateCartTotal($cart);

        // 3. Determine overall date range
        $rentalStart = $cart->items->min('rental_start');
        $rentalEnd = $cart->items->max('rental_end');
        $totalDays = $this->pricingService->calculateDays($rentalStart, $rentalEnd);

        return DB::transaction(function () use ($user, $cart, $pricing, $rentalStart, $rentalEnd, $totalDays, $paymentMethod, $notes) {
            // 4. Create rental with address snapshot
            $rental = Rental::create([
                'rental_code' => $this->generateCode(),
                'user_id' => $user->id,
                'status' => 'pending_payment',
                'rental_start' => $rentalStart,
                'rental_end' => $rentalEnd,
                'total_days' => $totalDays,
                'subtotal' => $pricing['subtotal'],
                'deposit_total' => $pricing['deposit_total'],
                'grand_total' => $pricing['grand_total'],
                'snapshot_address_street' => $user->address_street,
                'snapshot_address_city' => $user->address_city,
                'snapshot_address_province' => $user->address_province,
                'snapshot_address_postal_code' => $user->address_postal_code,
                'snapshot_address_detail' => $user->address_detail,
                'notes' => $notes,
            ]);

            // 5. Create rental items (snapshot product data)
            foreach ($cart->items as $item) {
                $days = $this->pricingService->calculateDays($item->rental_start, $item->rental_end);
                RentalItem::create([
                    'rental_id' => $rental->id,
                    'product_id' => $item->product_id,
                    'product_name' => $item->product->name,
                    'quantity' => $item->quantity,
                    'price_per_day' => $item->product->price_per_day,
                    'total_days' => $days,
                    'subtotal' => $item->product->price_per_day * $item->quantity * $days,
                    'deposit_per_item' => $item->product->deposit_amount,
                ]);
            }

            // 6. Create payment record
            Payment::create([
                'rental_id' => $rental->id,
                'method' => $paymentMethod,
                'amount' => $pricing['grand_total'],
                'status' => 'pending',
            ]);

            // 7. Clear cart
            $cart->items()->delete();

            return $rental->load('items', 'payment');
        });
    }

    private function generateCode(): string
    {
        return 'MTH-' . now()->format('Ymd') . '-' . str_pad(
            Rental::whereDate('created_at', today())->count() + 1, 3, '0', STR_PAD_LEFT
        );
    }
}
```

### 9.4 StoreService

```php
class StoreService
{
    public function isOpen(): bool
    {
        $now = now()->setTimezone('Asia/Jakarta');
        $dayOfWeek = strtolower($now->format('l')); // 'monday', 'tuesday', etc

        // Check holidays
        $holidays = StoreConfig::where('key', 'holiday_dates')->first();
        if ($holidays && in_array($now->format('Y-m-d'), json_decode($holidays->value))) {
            return false;
        }

        $hours = StoreConfig::where('key', 'operating_hours')->first();
        if (!$hours) return true;

        $schedule = json_decode($hours->value, true);
        $todayHours = $schedule[$dayOfWeek] ?? null;

        if (!$todayHours || $todayHours === 'closed') return false;

        [$open, $close] = explode('-', $todayHours);
        $currentTime = $now->format('H:i');

        return $currentTime >= $open && $currentTime <= $close;
    }
}
```

