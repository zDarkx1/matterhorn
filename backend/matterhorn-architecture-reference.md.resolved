### 10.2 Product Detail + Add to Cart

```tsx
// app/(main)/products/[slug]/page.tsx
'use client';

export default function ProductDetailPage({ params }: { params: { slug: string } }) {
    const product = useProduct(params.slug);  // fetch single product
    const { addItem } = useCartStore();
    const [dates, setDates] = useState({ start: '', end: '' });
    const [qty, setQty] = useState(1);

    const handleAddToCart = async () => {
        await addItem({
            product_id: product.id,
            quantity: qty,
            rental_start: dates.start,
            rental_end: dates.end,
        });
        toast.success('Ditambahkan ke keranjang!');
    };

    return (
        <div>
            <ImageGallery images={product.images} />
            <h1>{product.name}</h1>
            <PriceTag amount={product.price_per_day} suffix="/hari" />
            <DatePicker value={dates} onChange={setDates} />
            <QuantitySelector value={qty} onChange={setQty} max={product.available_stock} />
            <Button onClick={handleAddToCart}>Tambah ke Keranjang</Button>
        </div>
    );
}
```

