## 8. API Design — Endpoints Lengkap

### Standard Response Format

```json
// Success
{ "success": true, "data": { ... } }

// Success with message
{ "success": true, "data": { ... }, "message": "Berhasil ditambahkan" }

// Error
{ "success": false, "error": "Stok tidak mencukupi" }

// Paginated
{
    "success": true,
    "data": [ ... ],
    "meta": {
        "current_page": 1,
        "last_page": 5,
        "per_page": 12,
        "total": 58
    }
}
```

### ApiResponseTrait (Backend)

```php
trait ApiResponseTrait
{
    protected function sendSuccess($data, int $status = 200, string $message = null)
    {
        $response = ['success' => true, 'data' => $data];
        if ($message) $response['message'] = $message;
        return response()->json($response, $status);
    }

    protected function sendError(string $message, int $status = 400)
    {
        return response()->json(['success' => false, 'error' => $message], $status);
    }

    protected function sendCreated($data, string $message = null)
    {
        return $this->sendSuccess($data, 201, $message);
    }

    protected function sendNotFound(string $resource = 'Data')
    {
        return $this->sendError("$resource tidak ditemukan", 404);
    }

    protected function sendPaginated($paginator)
    {
        return response()->json([
            'success' => true,
            'data' => $paginator->items(),
            'meta' => [
                'current_page' => $paginator->currentPage(),
                'last_page' => $paginator->lastPage(),
                'per_page' => $paginator->perPage(),
                'total' => $paginator->total(),
            ],
        ]);
    }
}
```

