// app/(main)/products/page.tsx
'use client';

export default function ProductsPage() {
    const [filters, setFilters] = useState({ category: '', search: '', sort: 'newest' });
    const { data, isLoading, page, setPage } = useProducts(filters);

    return (
        <div>
            <ProductFilters filters={filters} onChange={setFilters} />
            <ProductGrid products={data?.items} isLoading={isLoading} />
            <Pagination current={page} total={data?.meta.last_page} onChange={setPage} />
        </div>
