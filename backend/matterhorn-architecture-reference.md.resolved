## 6. Database Schema & Migrations

### 6.1 Entity Relationship Diagram

```
┌──────────┐       ┌──────────┐       ┌──────────────┐
│  users   │───1:N─│  rentals │───1:N─│ rental_items │
│          │       │          │       │              │
│ id       │       │ id       │       │ rental_id    │
│ name     │       │ user_id  │       │ product_id   │
│ email    │       │ status   │       │ quantity     │
│ password │       │ total    │       │ price_per_day│
│ phone    │       │ start    │       │ subtotal     │
│ role     │       │ end      │       └──────┬───────┘
│ address* │       │ address  │              │
└────┬─────┘       │ snapshot │       ┌──────▼───────┐
     │             └────┬─────┘       │  products    │
     │                  │             │              │
     │             ┌────▼─────┐       │ id           │
     │             │ payments │       │ category_id  │
     │             │          │       │ name         │
     │             │ rental_id│       │ slug         │
     │             │ method   │       │ description  │
     │             │ amount   │       │ price_per_day│
     │             │ status   │       │ stock        │
     │             │ proof_url│       │ images[]     │
     │             └──────────┘       └──────┬───────┘
     │                                       │
     │  ┌──────────┐                  ┌──────▼───────┐
     ├──│  carts   │──1:N──┐         │ categories   │
     │  │          │       │         │              │
     │  │ user_id  │  ┌────▼─────┐   │ id           │
     │  └──────────┘  │cart_items│   │ name         │
     │                │          │   │ slug         │
     │                │ cart_id  │   │ icon         │
     │                │product_id│   └──────────────┘
     │                │ quantity │
     │                │ start   │
     │                │ end     │
     │                └─────────┘
     │
     │  ┌──────────┐
     └──│ reviews  │
        │          │
        │ user_id  │
        │product_id│
        │rental_id │
        │ rating   │
        │ comment  │
        └──────────┘
```

### 6.2 Tables Detail

#### `users`
```php
Schema::create('users', function (Blueprint $table) {
    $table->id();
    $table->string('name');
    $table->string('email')->unique();
    $table->string('password');
    $table->string('phone')->nullable();
    $table->enum('role', ['user', 'admin'])->default('user');
    // Address fields (untuk verifikasi identitas, BUKAN delivery)
    $table->string('address_street')->nullable();
    $table->string('address_city')->nullable();
    $table->string('address_province')->nullable();
    $table->string('address_postal_code')->nullable();
    $table->text('address_detail')->nullable();        // RT/RW, patokan
    $table->boolean('address_verified')->default(false);
    $table->string('avatar_url')->nullable();
    $table->timestamp('email_verified_at')->nullable();
    $table->rememberToken();
    $table->timestamps();
});
```

#### `categories`
```php
Schema::create('categories', function (Blueprint $table) {
    $table->id();
    $table->string('name');                  // "Tenda", "Sleeping Bag", "Carrier"
    $table->string('slug')->unique();        // "tenda", "sleeping-bag"
    $table->string('icon')->nullable();      // Icon name or URL
    $table->text('description')->nullable();
    $table->integer('sort_order')->default(0);
    $table->boolean('is_active')->default(true);
    $table->timestamps();
});
```

#### `products`
```php
Schema::create('products', function (Blueprint $table) {
    $table->id();
    $table->foreignId('category_id')->constrained()->onDelete('cascade');
    $table->string('name');                          // "Tenda Naturehike Cloud Up 2"
    $table->string('slug')->unique();
    $table->text('description');
    $table->text('specifications')->nullable();      // JSON or text: kapasitas, berat, material
    $table->integer('price_per_day');                 // Harga sewa per hari (Rupiah)
    $table->integer('stock');                         // Total unit yang dimiliki toko
    $table->integer('available_stock');               // Unit tersedia saat ini (stock - yang disewa)
    $table->json('images')->nullable();               // Array of image URLs
    $table->string('brand')->nullable();
    $table->string('condition')->default('good');     // good, fair, new
    $table->boolean('is_active')->default(true);
    $table->integer('min_rental_days')->default(1);
    $table->integer('max_rental_days')->default(30);
    $table->decimal('deposit_amount', 12, 0)->default(0); // Uang jaminan
    $table->integer('view_count')->default(0);
    $table->timestamps();
    $table->softDeletes();
});
```

#### `carts` & `cart_items`
```php
// carts — 1 user = 1 cart (persistent)
Schema::create('carts', function (Blueprint $table) {
    $table->id();
    $table->foreignId('user_id')->constrained()->onDelete('cascade');
    $table->timestamps();
});

// cart_items — items in a cart with date ranges
Schema::create('cart_items', function (Blueprint $table) {
    $table->id();
    $table->foreignId('cart_id')->constrained()->onDelete('cascade');
    $table->foreignId('product_id')->constrained()->onDelete('cascade');
    $table->integer('quantity')->default(1);
    $table->date('rental_start');              // Tanggal mulai sewa
    $table->date('rental_end');                // Tanggal selesai sewa
    $table->timestamps();

    $table->unique(['cart_id', 'product_id']); // 1 product per cart (update qty instead)
});
```

#### `rentals` & `rental_items`
```php
// rentals — master order
Schema::create('rentals', function (Blueprint $table) {
    $table->id();
    $table->string('rental_code')->unique();     // "MTH-20260414-001"
    $table->foreignId('user_id')->constrained();
    $table->enum('status', [
        'pending_payment',       // Menunggu pembayaran
        'payment_uploaded',      // Bukti sudah diupload, menunggu verifikasi
        'confirmed',             // Pembayaran dikonfirmasi admin
        'picked_up',             // Barang sudah diambil di toko
        'active',                // Sedang dipinjam (= picked_up + past start date)
        'returned',              // Barang sudah dikembalikan
        'completed',             // Admin sudah cek kondisi, selesai
        'cancelled',             // Dibatalkan
        'overdue',               // Melewati tanggal return
    ])->default('pending_payment');
    $table->date('rental_start');
    $table->date('rental_end');
    $table->integer('total_days');
    $table->decimal('subtotal', 12, 0);          // Total sebelum deposit
    $table->decimal('deposit_total', 12, 0)->default(0);
    $table->decimal('grand_total', 12, 0);       // subtotal + deposit
    // Address snapshot (saat checkout, tidak berubah walaupun user update alamat)
    $table->string('snapshot_address_street');
    $table->string('snapshot_address_city');
    $table->string('snapshot_address_province');
    $table->string('snapshot_address_postal_code');
    $table->text('snapshot_address_detail')->nullable();
    $table->text('notes')->nullable();            // Catatan dari user
    $table->text('admin_notes')->nullable();      // Catatan dari admin
    $table->timestamp('paid_at')->nullable();
    $table->timestamp('picked_up_at')->nullable();
    $table->timestamp('returned_at')->nullable();
    $table->timestamp('completed_at')->nullable();
    $table->timestamp('cancelled_at')->nullable();
    $table->string('cancelled_reason')->nullable();
    $table->timestamps();
});

// rental_items — detail produk per rental
Schema::create('rental_items', function (Blueprint $table) {
    $table->id();
    $table->foreignId('rental_id')->constrained()->onDelete('cascade');
    $table->foreignId('product_id')->constrained();
    $table->string('product_name');              // Snapshot nama (jaga konsistensi)
    $table->integer('quantity');
    $table->integer('price_per_day');            // Snapshot harga saat checkout
    $table->integer('total_days');
    $table->decimal('subtotal', 12, 0);          // qty × price × days
    $table->decimal('deposit_per_item', 12, 0)->default(0);
    $table->timestamps();
});
```

#### `payments`
```php
Schema::create('payments', function (Blueprint $table) {
    $table->id();
    $table->foreignId('rental_id')->constrained()->onDelete('cascade');
    $table->enum('method', ['bank_transfer', 'ewallet', 'cash']);
    $table->decimal('amount', 12, 0);
    $table->enum('status', [
        'pending',         // Belum bayar
        'uploaded',        // Bukti sudah diupload
        'confirmed',       // Admin sudah konfirmasi
        'rejected',        // Admin tolak (bukti tidak valid)
    ])->default('pending');
    $table->string('proof_url')->nullable();     // URL bukti transfer
    $table->string('bank_name')->nullable();     // Nama bank pengirim
    $table->string('account_name')->nullable();  // Nama pengirim
    $table->text('admin_note')->nullable();       // Catatan admin (jika reject)
    $table->timestamp('confirmed_at')->nullable();
    $table->timestamp('rejected_at')->nullable();
    $table->timestamps();
});
```

#### `reviews`
```php
Schema::create('reviews', function (Blueprint $table) {
    $table->id();
    $table->foreignId('user_id')->constrained();
    $table->foreignId('product_id')->constrained();
    $table->foreignId('rental_id')->constrained();
    $table->tinyInteger('rating');              // 1-5
    $table->text('comment')->nullable();
    $table->timestamps();

    $table->unique(['user_id', 'rental_id', 'product_id']); // 1 review per product per rental
});
```

#### `store_configs`
```php
Schema::create('store_configs', function (Blueprint $table) {
    $table->id();
    $table->string('key')->unique();           // 'operating_hours', 'store_address', 'store_phone'
    $table->json('value');                     // JSON value
    $table->timestamps();
});

// Seeder data:
// key: 'operating_hours' → value: {"mon":"08:00-20:00","tue":"08:00-20:00",...,"sun":"closed"}
// key: 'store_address' → value: {"street":"...","city":"...","maps_url":"..."}
// key: 'store_phone' → value: {"phone":"08xx","whatsapp":"08xx"}
// key: 'holiday_dates' → value: ["2026-01-01","2026-03-29",...]
```

