## 7. Authentication & Authorization

### 7.1 Auth Flow (Sanctum Token-Based)

```
┌──────────┐   POST /auth/register   ┌───────────┐
│ Frontend │ ──────────────────────→  │  Laravel   │
│ Next.js  │   { name, email, pass } │  Sanctum   │
│          │                          │            │
│          │ ← { user, token } ────  │ createToken│
│          │                          │ ('auth')   │
│          │   Stores token in        └───────────┘
│          │   localStorage/cookie
│          │
│          │   POST /auth/login
│          │ ──────────────────────→  Same flow
│          │ ← { user, token } ────
│          │
│          │   GET /any-protected-route
│          │   Authorization: Bearer <token>
│          │ ──────────────────────→  Sanctum verifies → allow/deny
└──────────┘
```

### 7.2 Backend Auth Implementation

```php
// AuthController.php
class AuthController extends Controller
{
    use ApiResponseTrait;

    public function register(RegisterRequest $request)
    {
        $user = User::create([
            'name' => $request->name,
            'email' => $request->email,
            'password' => Hash::make($request->password),
        ]);

        // Create persistent cart for user
        Cart::create(['user_id' => $user->id]);

        $token = $user->createToken('auth')->plainTextToken;

        return $this->sendSuccess([
            'user' => new UserResource($user),
            'token' => $token,
        ], 201);
    }

    public function login(LoginRequest $request)
    {
        if (!Auth::attempt($request->only('email', 'password'))) {
            return $this->sendError('Email atau password salah', 401);
        }

        $user = Auth::user();
        $token = $user->createToken('auth')->plainTextToken;

        return $this->sendSuccess([
            'user' => new UserResource($user),
            'token' => $token,
        ]);
    }

    public function me(Request $request)
    {
        return $this->sendSuccess([
            'user' => new UserResource($request->user()),
        ]);
    }

    public function logout(Request $request)
    {
        $request->user()->currentAccessToken()->delete();
        return $this->sendSuccess(['message' => 'Berhasil logout']);
    }
}
```

### 7.3 Frontend Auth Store

```typescript
// stores/useAuthStore.ts
interface AuthState {
    user: User | null;
    token: string | null;
    isAdmin: boolean;
    loading: boolean;

    login: (email: string, password: string) => Promise<void>;
    register: (name: string, email: string, password: string) => Promise<void>;
    logout: () => Promise<void>;
    fetchMe: () => Promise<void>;
    hasAddress: () => boolean;
}

export const useAuthStore = create<AuthState>()(
    persist(
        (set, get) => ({
            user: null,
            token: null,
            isAdmin: false,
            loading: false,

            login: async (email, password) => {
                const { user, token } = await authService.login(email, password);
                set({ user, token, isAdmin: user.role === 'admin' });
            },

            register: async (name, email, password) => {
                const { user, token } = await authService.register(name, email, password);
                set({ user, token, isAdmin: false });
            },

            logout: async () => {
                await authService.logout();
                set({ user: null, token: null, isAdmin: false });
                useCartStore.getState().clearCart();
            },

            hasAddress: () => {
                const user = get().user;
                return !!(user?.address_street && user?.address_city);
            },
        }),
        { name: 'matterhorn-auth' } // localStorage key
    )
);
```

### 7.4 API Fetch Wrapper (Auto-attach Token)

```typescript
// lib/api.ts
const API_URL = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:8000/api';

export async function apiFetch<T>(
    endpoint: string,
    options: RequestInit = {}
): Promise<T> {
    const token = useAuthStore.getState().token;

    const headers: Record<string, string> = {
        'Content-Type': 'application/json',
        Accept: 'application/json',
        ...((options.headers as Record<string, string>) || {}),
    };

    if (token) {
        headers['Authorization'] = `Bearer ${token}`;
    }

    const response = await fetch(`${API_URL}${endpoint}`, {
        ...options,
        headers,
    });

    // Handle 401 → force logout
    if (response.status === 401) {
        useAuthStore.getState().logout();
        throw new Error('Sesi telah berakhir, silakan login kembali');
    }

    const data = await response.json();

    if (!response.ok || !data.success) {
        throw new Error(data.error || data.message || 'Terjadi kesalahan');
    }

    return data.data as T;
}

// For file uploads (FormData, no Content-Type header)
export async function apiUpload<T>(
    endpoint: string,
    formData: FormData
): Promise<T> {
    const token = useAuthStore.getState().token;
    const headers: Record<string, string> = { Accept: 'application/json' };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    const response = await fetch(`${API_URL}${endpoint}`, {
        method: 'POST',
        headers,
        body: formData,
    });

    const data = await response.json();
    if (!response.ok || !data.success) throw new Error(data.error || 'Upload gagal');
    return data.data as T;
}
```

### 7.5 Role-Based Authorization

| Role | Access |
|------|--------|
| **Guest** | Browse products, categories, store info |
| **User** | + Cart, checkout, rentals, profile, reviews |
| **Admin** | + Manage products, categories, rentals, payments, users, settings |

```php
// routes/api.php
// Public routes (no auth)
Route::get('/products', [ProductController::class, 'index']);
Route::get('/products/{slug}', [ProductController::class, 'show']);
Route::get('/categories', [CategoryController::class, 'index']);
Route::get('/store/info', [StoreInfoController::class, 'index']);
Route::post('/auth/register', [AuthController::class, 'register']);
Route::post('/auth/login', [AuthController::class, 'login']);

// Authenticated user routes
Route::middleware('auth:sanctum')->group(function () {
    Route::post('/auth/logout', [AuthController::class, 'logout']);
    Route::get('/auth/me', [AuthController::class, 'me']);

    // Cart
    Route::get('/cart', [CartController::class, 'index']);
    Route::post('/cart/items', [CartController::class, 'addItem']);
    Route::put('/cart/items/{id}', [CartController::class, 'updateItem']);
    Route::delete('/cart/items/{id}', [CartController::class, 'removeItem']);
    Route::delete('/cart', [CartController::class, 'clear']);

    // Checkout & Rentals
    Route::post('/rentals/checkout', [RentalController::class, 'checkout'])
         ->middleware(['ensure.has.address', 'ensure.store.open']);
    Route::get('/rentals', [RentalController::class, 'index']);
    Route::get('/rentals/{id}', [RentalController::class, 'show']);
    Route::post('/rentals/{id}/cancel', [RentalController::class, 'cancel']);

    // Payment
    Route::post('/payments/{rentalId}/upload', [PaymentController::class, 'uploadProof']);

    // Profile
    Route::get('/users/profile', [UserController::class, 'profile']);
    Route::put('/users/profile', [UserController::class, 'updateProfile']);
    Route::put('/users/address', [UserController::class, 'updateAddress']);

    // Reviews
    Route::post('/reviews', [ReviewController::class, 'store']);
});

// Admin routes
Route::middleware(['auth:sanctum', 'ensure.is.admin'])->prefix('admin')->group(function () {
    Route::get('/dashboard', [AdminDashboardController::class, 'index']);
    Route::apiResource('/products', AdminProductController::class);
    Route::apiResource('/categories', AdminCategoryController::class);
    Route::get('/rentals', [AdminRentalController::class, 'index']);
    Route::put('/rentals/{id}/status', [AdminRentalController::class, 'updateStatus']);
    Route::put('/payments/{id}/confirm', [AdminPaymentController::class, 'confirm']);
    Route::put('/payments/{id}/reject', [AdminPaymentController::class, 'reject']);
    Route::get('/users', [AdminUserController::class, 'index']);
    Route::put('/settings', [AdminDashboardController::class, 'updateSettings']);
});
```

